{
  "$comment": [
    "Copy this file to tools/check_tokens.local.json to add vocabulary that only",
    "your checkout should reject. The copy is gitignored, so the words you add",
    "are never published with the library — which is the point: the discipline",
    "check needs to name an application's nouns to catch them, and naming them",
    "in a tracked file would defeat the rule it enforces.",
    "",
    "Both lists are additive; the generic checks run either way."
  ],
  "business_words": ["example-app-name", "example-internal-term"],
  "app_markers": ["example-app-name", "apps/example-app"]
}
